# Security Headers for all files
/*
  # Content Security Policy  
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://gcckwqkzjoxraikosash.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://gcckwqkzjoxraikosash.supabase.co https://www.google-analytics.com; frame-src 'self' https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self';
  
  # Security Headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # SEO Headers
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# Cache static assets for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 1 year
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: index, follow
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: index, follow
/*.png
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: index, follow
/*.webp
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: index, follow
/*.svg
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: index, follow
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts for 1 year
/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Embedder-Policy: require-corp
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Embedder-Policy: require-corp
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS and JS for 1 year
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML files - short cache with revalidation
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# Root HTML
/
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# API Routes - No caching, no indexing
/api/*
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex, nofollow

# Admin/Dashboard - Block indexing
/admin/*
  X-Robots-Tag: noindex, nofollow
  
/dashboard/*
  X-Robots-Tag: noindex, nofollow

/auth/*
  X-Robots-Tag: noindex, nofollow

# SEO Files
/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=86400
  X-Robots-Tag: index, follow

/sitemap-images.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=86400
  X-Robots-Tag: index, follow

